{
  "name": "frontend",
  "description": "Frontend for Kasho :: Mashin",
  "version": "0.0.0",
  "author": "MrMat",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/MrMatAP/kaso-mashin",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrMatAP/kaso-mashin.git"
  },
  "bugs": {
    "url": "https://github.com/MrMatAP/kaso-mashin/issues"
  },
  "scripts": {
    "dev": "vite",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "ci-lint": "npx eslint . --format @microsoft/eslint-formatter-sarif --output-file build/lint.sarif",
    "lint": "npx eslint .",
    "package": "vue-tsc --noEmit && vite build --outDir ../kaso_mashin/server/static/ --emptyOutDir",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@jetbrains/icons": "^4.4.0",
    "@mdi/font": "7.0.96",
    "@novnc/novnc": "^1.5.0",
    "@types/novnc-core": "^0.1.6",
    "@xterm/addon-attach": "^0.11.0",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "core-js": "^3.37.0",
    "install": "^0.13.0",
    "mande": "^2.0.8",
    "novnc-core": "^0.3.0",
    "npm": "^10.8.3",
    "pinia": "^2.1.7",
    "quasar": "^2.15.4",
    "roboto-fontface": "^0.10.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@quasar/extras": "^1.17.0",
    "@quasar/vite-plugin": "^1.10.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint-plugin-vue": "^10.5.1",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "sass-embedded": "^1.93.2",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
